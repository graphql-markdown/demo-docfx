{
  "name": "demo-docfx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./docs/graphql ./_site",
    "generate": "node ./scripts/generate-docs.mjs",
    "dev": "npm run generate && docfx docfx.json --serve",
