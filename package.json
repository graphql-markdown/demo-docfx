    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.2.3",
    "@graphql-markdown/formatters": "^1.2.3",
    "@graphql-tools/url-loader": "^10.0.9",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.9.0",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
